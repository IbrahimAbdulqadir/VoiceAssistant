# Copy this file to config/.env and fill in real values. config/.env itself must
# never be committed -- it's already in .gitignore.

# Spotify Web API (see README.md "Spotify Web API setup")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Gmail API doesn't use env vars -- it reads config/gmail_credentials.json directly
# (see README.md "Gmail API setup").

# Phase 2: wake word + voice input (see README.md "Wake word + voice input setup")
# No account/API key needed -- openWakeWord runs fully locally.
WAKE_WORD=Spiderman           # custom -- needs config/wake_word.onnx (see README for training steps)
# WHISPER_MODEL=small         # optional -- tiny/base/small/medium (bigger = more accurate, slower)
# WAKE_THRESHOLD=0.6          # optional -- raise if a custom model false-triggers on background noise
# SILENCE_SECONDS=5.0         # optional -- how long to wait for trailing silence before ending a recording

# Spoken feedback (assistant/tts.py) -- speaks "done", "I don't understand", etc.
# after every voice command instead of only printing/logging it
# SPEAK_RESPONSES=1           # optional -- set to 0 to disable spoken feedback
# ASSISTANT_USER_NAME=Ibrahim # optional -- name used in spoken responses
# TTS_RATE=200                # optional -- words per minute override

# Phase 3: speaker verification -- config/voiceprint.npy is created by `python main.py --enroll`
# SPEAKER_THRESHOLD=0.72      # optional -- cosine similarity cutoff, lower = more lenient

# Phase 4: LLM tool-calling backend -- set whichever one you're using
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano     # optional override
